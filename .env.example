# SMTP-Zugangsdaten für das Kontaktformular (src/app/api/contact/route.ts)
# Diese Werte bei eurem Hosting-/E-Mail-Provider erhalten und als echte
# Umgebungsvariablen setzen (z. B. in Vercel unter Project Settings > Environment Variables).
# Ohne diese Variablen antwortet das Kontaktformular mit einer Fehlermeldung.

SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=info@fil-truck-center.de
SMTP_PASS=
CONTACT_TO_EMAIL=info@fil-truck-center.de
